# Create a .env file in the root directory and add your API keys here
# This project supports RapidRouter, OpenAI, and Groq API Keys; using any one will work
RAPIDROUTER_API_KEY = "insert your RapidRouter API key here"
OPENAI_API_KEY = "insert your OpenAI API key here"
GROQ_API_KEY = "insert your Groq API key here"

# Optional overrides
# LLM_PROVIDER = "rapidrouter"  # rapidrouter | openai | groq
# LLM_MODEL = "openai/gpt-oss-120b"